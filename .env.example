# Token del bot ottenuto da @BotFather su Telegram (obbligatorio)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opzionale) Lista di chat_id autorizzati a usare il bot, separati da virgola.
# Se vuota, chiunque trovi il bot potrà aggiungere ricerche.
# Per scoprire il tuo chat_id, scrivi al bot @userinfobot su Telegram.
ALLOWED_CHAT_IDS=

# Ogni quanti secondi controllare Vinted per nuovi annunci.
# Non scendere troppo (es. sotto i 60-90s) per non rischiare blocchi anti-bot.
POLL_INTERVAL_SECONDS=90

# Quanti articoli leggere ad ogni controllo per ciascuna ricerca (max 96)
ITEMS_PER_PAGE=20

# Cartella dove salvare il database SQLite e i cookie di sessione Vinted
DATA_DIR=./data

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
